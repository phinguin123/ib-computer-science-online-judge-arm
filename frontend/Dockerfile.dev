# Development Dockerfile for Vue.js Frontend
# This image is used for hot-reloading during development
# ARM64: node:16-bookworm has native ARM64 support
FROM node:16-bookworm

WORKDIR /app

# Copy package files first for better caching
COPY package.json yarn.lock ./

# Install dependencies
RUN npm install

# The source code will be mounted as a volume
# We don't copy it here to enable hot-reloading

# Expose the dev server port (default is 8080, configurable via PORT env var)
EXPOSE 8080

# The command will be overridden in docker-compose.dev.yml
# Default: run the dev server
CMD ["npm", "run", "dev"]

